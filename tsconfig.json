{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true, "jsx": "react-jsx",
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "lib": ["ES2023", "DOM"], "types": ["react"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/stub-primitives.tsx"]
}
