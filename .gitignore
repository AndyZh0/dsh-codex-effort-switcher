# Installed dependencies.
node_modules/

# Build output. package.json's "files" list still ships lib/ inside the archive;
# this rule only keeps it out of git.
lib/

# The esbuild bundle the test runner writes.
.test/

# Archives produced by `npm pack`.
*.tgz

# Browser-smoke evidence: run directories and the screenshots copied out of them.
.runtime/

# Local design references for this card (screenshots of the shipped picker) and
# the Windows shortcut to this directory. Neither belongs to the plugin.
1.png
2.png
*.lnk
